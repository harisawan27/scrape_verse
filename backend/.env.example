# ==============================================================================
# Web Radar — Production Backend Environment Configuration Template
# Copy this file to .env and provide your actual credentials. Never commit .env.
# ==============================================================================

# --- Database (Neon PostgreSQL) ---
# Format: postgresql+psycopg://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Application Environment ---
APP_ENV=production
LOG_LEVEL=INFO

# --- Autonomous Background Worker & Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=10.0

# --- Bright Data Scraper Studio Integration ---
# Your Bright Data API Key (Bearer token) from https://brightdata.com/cp
BRIGHT_DATA_API_KEY=
# Your custom Scraper Studio Collector ID (e.g., c_msz0zrtw29tjzhzakl)
BRIGHT_DATA_COLLECTOR_ID=c_msz0zrtw29tjzhzakl
BRIGHT_DATA_BASE_URL=https://api.brightdata.com
BRIGHT_DATA_POLL_TIMEOUT_SECONDS=60.0
BRIGHT_DATA_POLL_INTERVAL_SECONDS=2.0

# --- Google Gemini AI Natural-Language Planner ---
# Your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- CORS Allowed Origins ---
# Comma-separated list or JSON array of allowed frontend URLs
CORS_ORIGINS=http://localhost:3000,https://your-webradar-frontend.vercel.app
