# Web Radar Frontend Environment Variables

# URL of the deployed FastAPI backend (e.g. https://harisawan27-web-radar.hf.space on production or http://localhost:8000 on local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL of your branch-specific Neon Auth instance (from Neon Console -> Auth)
NEON_AUTH_BASE_URL=https://ep-wandering-field-azdf3dzw.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth

# Secret key for encrypting Next.js session cookies (minimum 32 characters)
NEON_AUTH_COOKIE_SECRET=your-secure-32-character-session-cookie-secret
